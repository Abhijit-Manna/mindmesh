# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_agent_model
EVALUATION_MODEL=your_evaluation_model

# Serper.dev
SERPER_API_KEY=your_serper_api_key

# Agent Retry Settings
MAX_AGENT_RETRIES=2

# Evaluation Settings
ENABLE_EVALUATION=true
EVALUATION_THRESHOLD=0.70

# Agent Runtime
AGENT_TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL=INFO