# ==========================================
# GEMINI API KEYS
# ==========================================

GEMINI_API_KEY_BA=enter_your_key
GEMINI_API_KEY_SA=enter_your_key
GEMINI_API_KEY_TA=enter_your_key
GEMINI_API_KEY_DP=enter_your_key
GEMINI_API_KEY_RW=enter_your_key
GEMINI_API_KEY_EV=enter_your_key


# ==========================================
# AGENT MODELS
# ==========================================

BA_MODEL=gemini/gemini-3.5-flash-lite
 SA_MODEL=gemini/gemini-3.5-flash-lite
 TA_MODEL=gemini/gemini-3.5-flash-lite
 DP_MODEL=gemini/gemini-3.5-flash-lite
 RW_MODEL=gemini/gemini-3.5-flash-lite
 EVALUATION_MODEL=gemini/gemini-3.5-flash


# ==========================================
# SERPER.DEV
# ==========================================

SERPER_API_KEY=your_serper_api_key


# ==========================================
# API SECURITY
# ==========================================

# Shared secret for /blueprints endpoints. Leave empty to disable
# header checking (development only). When set, every blueprint route
# requires the X-API-Key header to match.
API_SECRET_KEY=


# ==========================================
# AGENT RETRY SETTINGS
# ==========================================

MAX_AGENT_RETRIES=3


# ==========================================
# EVALUATION SETTINGS
# ==========================================

ENABLE_EVALUATION=true
EVALUATION_THRESHOLD=0.70


# ==========================================
# AGENT RUNTIME
# ==========================================

AGENT_TIMEOUT_SECONDS=120


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO