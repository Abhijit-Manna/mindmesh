GEMINI_API_KEY_BA=enter your key
GEMINI_API_KEY_SA=enter your key
GEMINI_API_KEY_TA=enter your key
GEMINI_API_KEY_DP=enter your key

GEMINI_MODEL=gemini/gemini-3.1-flash-lite
EVALUATION_MODEL=gemini/gemini-3.1-flash-lite

# Serper.dev
SERPER_API_KEY=your_serper_api_key

# Agent Retry Settings
MAX_AGENT_RETRIES=2

# Evaluation Settings
ENABLE_EVALUATION=true
EVALUATION_THRESHOLD=0.70

# Agent Runtime
AGENT_TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL=INFO