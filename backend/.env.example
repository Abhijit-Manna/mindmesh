# ==========================================
# GEMINI API KEYS
# ==========================================

GEMINI_API_KEY_BA=enter_your_key
GEMINI_API_KEY_SA=enter_your_key
GEMINI_API_KEY_TA=enter_your_key
GEMINI_API_KEY_DP=enter_your_key
GEMINI_API_KEY_RW=enter_your_key
GEMINI_API_KEY_EV=enter_your_key


# ==========================================
# AGENT MODELS
# ==========================================

BA_MODEL=gemini/gemini-3.5-flash-lite
 SA_MODEL=gemini/gemini-3.5-flash-lite
 TA_MODEL=gemini/gemini-3.5-flash-lite
 DP_MODEL=gemini/gemini-3.5-flash-lite
 RW_MODEL=gemini/gemini-3.5-flash-lite
 EVALUATION_MODEL=gemini/gemini-3.5-flash


# ==========================================
# OPENROUTER FALLBACK
# ==========================================
# Used automatically when an agent's or evaluator's primary LLM call fails
# due to transient provider issues (demand spike, resource exhausted,
# rate limit, outage, timeout, ...). Set OPENROUTER_API_KEY to enable.
# Model can be a bare OpenRouter slug (the openrouter/ prefix is added
# automatically), e.g.
#   nvidia/nemotron-3.5-lightning:free
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
#   openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
# When true, fall back on ANY primary error. When false, fall back only on
# transient provider errors (rate limits, capacity, 5xx, timeouts, ...).
OPENROUTER_FALLBACK_ON_ALL_ERRORS=true


# ==========================================
# SERPER.DEV
# ==========================================

SERPER_API_KEY=your_serper_api_key


# ==========================================
# API SECURITY
# ==========================================

# Shared secret for /blueprints endpoints. Leave empty to disable
# header checking (development only). When set, every blueprint route
# requires the X-API-Key header to match.
API_SECRET_KEY=


# ==========================================
# AGENT RETRY SETTINGS
# ==========================================

MAX_AGENT_RETRIES=3


# ==========================================
# EVALUATION SETTINGS
# ==========================================

ENABLE_EVALUATION=true
EVALUATION_THRESHOLD=0.70


# ==========================================
# AGENT RUNTIME
# ==========================================

AGENT_TIMEOUT_SECONDS=120

# Maximum output tokens per agent/evaluator LLM call. Agent deliverables are
# long (14-section documents containing Mermaid diagrams); a small cap
# truncates them mid-section and can leave diagrams syntactically invalid.
LLM_MAX_TOKENS=8192


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO


# ==========================================
# DIAGRAM RENDERING
# ==========================================

# Server-side Mermaid SVG pre-rendering (via npx mmdc). When true, diagrams
# are embedded as inline SVG so the downloaded HTML renders offline.
# Set to false to use client-side Mermaid.js rendering instead (browser
# needs internet access to the CDN).
MERMAID_SSR=true
